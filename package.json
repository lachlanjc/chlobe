{
  "name": "@chlobe/react",
  "version": "0.2.0",
  "description": "A lightweight, interactive React choropleth globe for visualizing country data using WebGL.",
  "keywords": [
    "choropleth",
    "cobe",
    "countries",
    "dataviz",
    "globe",
    "react",
    "webgl"
  ],
  "homepage": "https://chlobe.lachlanjc.com",
  "bugs": "https://github.com/lachlanjc/chlobe/issues",
  "license": "MIT",
  "author": "lachlanjc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lachlanjc/chlobe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:bundle-size": "tsdown --config tsdown.bundle-size.config.ts",
    "bundlemon": "bundlemon",
    "dev": "tsdown --watch",
    "generate": "pnpm generate:country-data && pnpm generate:globe-shaders",
    "generate:country-data": "node scripts/generate-country-data.mjs",
    "pull:environmental-data": "node scripts/pull-environmental-data.mjs",
    "generate:globe-shaders": "node scripts/generate-globe-shaders.mjs",
    "prebuild": "pnpm generate",
    "prepack": "pnpm build",
    "render:og-video": "node scripts/render-og-video.mjs",
    "test": "vitest run",
    "test:browser": "pnpm --filter website build && playwright test",
    "test:consumer": "pnpm build && node scripts/verify-consumer.mjs",
    "test:coverage": "vitest run --coverage",
    "test:pack": "pnpm build && node scripts/verify-pack.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "^5.1.0",
    "bundlemon": "^3.2.0",
    "d3-geo": "^3.1.2",
    "iso-3166": "^4.4.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "react": "catalog:",
    "topojson-client": "^3.1.0",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
