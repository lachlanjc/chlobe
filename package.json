{
  "name": "@lachlanjc/chlobe",
  "version": "0.0.1",
  "description": "Lightweight WebGL globe for rendering values of countries as shaded regions.",
  "keywords": [
    "choropleth",
    "cobe",
    "countries",
    "globe",
    "react",
    "webgl"
  ],
  "homepage": "https://chlobe.lachlanjc.com",
  "bugs": "https://github.com/lachlanjc/chlobe/issues",
  "license": "MIT",
  "author": "lachlanjc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lachlanjc/chlobe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:bundle-size": "tsup --config tsup.bundle-size.config.ts",
    "bundlemon": "bundlemon",
    "dev": "tsup src/index.ts --format cjs,esm --dts --clean --watch",
    "generate": "pnpm generate:country-data && pnpm generate:globe-shaders",
    "generate:country-data": "node scripts/generate-country-data.mjs",
    "pull:environmental-data": "node scripts/pull-environmental-data.mjs",
    "generate:globe-shaders": "node scripts/generate-globe-shaders.mjs",
    "prebuild": "pnpm generate",
    "test": "vitest run",
    "test:browser": "pnpm --filter website build && playwright test",
    "test:consumer": "pnpm build && node scripts/verify-consumer.mjs",
    "test:coverage": "vitest run --coverage",
    "test:pack": "pnpm build && node scripts/verify-pack.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "^3.0.0",
    "bundlemon": "^3.1.0",
    "d3-geo": "^3.1.1",
    "iso-3166": "^4.1.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-plugin-react-doctor": "^0.7.8",
    "react": "catalog:",
    "topojson-client": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "catalog:",
    "ultracite": "7.10.2",
    "vitest": "^3.0.0",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
