{
  "baseDir": "./.bundle-size",
  "defaultCompression": "gzip",
  "files": [
    {
      "path": "index.js",
      "maxSize": "25 kB",
      "maxPercentIncrease": 5
    },
    {
      "path": "countries-110m-<hash>.js",
      "maxSize": "42 kB",
      "maxPercentIncrease": 5
    }
  ],
  "groups": [
    {
      "path": "**/*.js",
      "maxSize": "65 kB",
      "maxPercentIncrease": 5
    }
  ],
  "reportOutput": ["github"]
}
